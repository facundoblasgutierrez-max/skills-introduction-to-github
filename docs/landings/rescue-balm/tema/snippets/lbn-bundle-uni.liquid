{%- comment -%}
  LBN BUNDLE — selector de packs UNIFICADO. Una sola pieza para todos los kits.
  Uso:  {% render 'lbn-bundle-uni' %}
  Params opcionales:  dias: 30   (dias de tratamiento por unidad)
                      lp01: true  (4-oct, sólo Kit Reafirmante piloto MIL-KRF-LP01: rótulos por
                                   ahorro, sin días de uso ni nota, oferta en la barra de envío)
                      cta: 'texto del botón' (default 'Agregar al carrito')
                      nota: 'texto chico debajo del selector'

  18-sep — El layout del Kit Reafirmante (antes "test" solo en ese handle) pasa a
  ser el layout de TODOS los kits:
   - barra negra de envio gratis arriba, 2 lineas por opcion, pill de % OFF,
     "X dias de tratamiento · ahorras $Y", preselecciona 2 unidades ("Mas elegida").
   - El escalon de 3 unidades SOLO aparece donde existe el descuento automatico
     real "25% OFF llevando 3" (lista kit25_handles). Si se suma un kit a ese
     descuento en Shopify, agregar su handle aca y aparece el escalon.
   - Envio gratis: la regla real corre sobre PRECIO DE LISTA (product.price * qty)
     >= settings.free_shipping_threshold. Si 1 unidad ya llega, la barra dice
     "en toda la compra"; si no, dice "desde $X" y marca en verde las opciones
     que si llegan.
   - Posicion: siempre arriba de Cantidad + Agregar al carrito (ver script).
  Descuentos reales detras: "15% OFF en la 2da unidad" (7,5% del pedido desde 2u,
  todos los productos) y "25% OFF llevando 3" (solo handles de kit25_handles).
  18-sep tarde: los 10 kits tienen su propio descuento 25% (3 del mismo kit), activos.
{%- endcomment -%}
{%- liquid
  assign pre_show_offer = false
  if product.handle == 'pre-show-serum'
    assign pre_show_offer = true
  endif
  assign kit25_handles = 'kit-anti-brotes-361,kit-beautycaster®-super-renovacion-celular,kit-cloud-skin,kit-cuello-menton-lift-like-milaborit,kit-firmeza-hidratacion-profunda-botox-like-milaborit-1,kit-firmeza-proteccion-diaria-botox-like-dia,kit-glass-skin-duo,kit-m-start,kit-repara-tu-piel-dia-noche-®vegaplay,kit-tratamiento-ojeras-bolsas,kit-dia-de-la-madre,vegaplay-®-patagonia-rescue-balm-balsamo-multiuso-con-calendula'
  assign kit25_list = kit25_handles | split: ','
  assign kit25 = false
  if kit25_list contains product.handle
    assign kit25 = true
  endif
  # 30-sep — en los kits las opciones dicen «1 kit / 2 kits» y «$X por kit» (pedido de Facu)
  assign es_kit = false
  if kit25 or product.handle contains 'kit-'
    assign es_kit = true
  endif
  # 17-oct — Patagonia Rescue Balm (C11): 2do bálsamo al 44% OFF (BxGy) y 25% OFF llevando 3
  # (está en kit25_handles por el descuento, pero no es kit). Textos propios abajo.
  assign rbalm = false
  if product.handle == 'vegaplay-®-patagonia-rescue-balm-balsamo-multiuso-con-calendula'
    assign rbalm = true
    assign es_kit = false
  endif

  assign n = 2
  if kit25
    assign n = 3
  endif
  assign pre = 1
  assign best = 2

  assign mas_elegido_handles = 'kit-firmeza-hidratacion-profunda-botox-like-milaborit-1,kit-cuello-menton-lift-like-milaborit,ultrabalance5-serum,hydraplump-ocean-serum-milaborit,crema-corporal-rosa-mosqueta-vegaplay' | split: ','
  assign mas_elegido = false
  if mas_elegido_handles contains product.handle
    assign mas_elegido = true
  endif

  assign dias_u = dias | default: 30
  assign nota_txt = nota | default: ''
  assign reaf_list = 'kit-firmeza-hidratacion-profunda-botox-like-milaborit-1,kit-firmeza-proteccion-diaria-botox-like-dia,kit-cuello-menton-lift-like-milaborit' | split: ','
  assign kit_list  = 'kit-tratamiento-ojeras-bolsas,kit-m-start,kit-cloud-skin,kit-anti-brotes-361,kit-glass-skin-duo,kit-beautycaster®-super-renovacion-celular,kit-repara-tu-piel-dia-noche-®vegaplay' | split: ','
  if nota_txt == blank
    if reaf_list contains product.handle
      assign nota_txt = 'La firmeza se consolida entre el mes 2 y el 3 de uso sostenido.'
    elsif kit_list contains product.handle
      assign nota_txt = 'Los resultados se consolidan con el uso sostenido.'
    endif
  endif

  if lp01
    assign nota_txt = nota | default: ''
  endif
  assign cta_txt = cta | default: 'Agregar al carrito'

  assign fst = settings.free_shipping_threshold | times: 100
  assign free_from_one = false
  if fst <= 0 or product.price >= fst
    assign free_from_one = true
  endif

  assign ref = product.compare_at_price
  if ref == blank or ref < product.price
    assign ref = product.price
  endif
  assign lp_pct = ref | minus: product.price | times: 100.0 | divided_by: ref | round

  # 21-sep — opcion COMBO: 2 unidades de este producto + 1 del producto par.
  # Solo en los handles de combo_pairs (handle:handle_del_par). Sin descuento propio:
  # corre el mismo "15% OFF en la 2da unidad" (7,5% del pedido desde 2u) que la opcion de 2.
  # Si alguno de los dos no tiene stock para el combo, la opcion no se muestra.
  # 22-sep — sumados EyeUp + Bouncy Cream y UltraBalance5+ + SoftCloud (espuma). Los textos
  # de cada combo (nombre, detalle, para que sirve el complemento) van en el case de abajo.
  assign combo_pairs = 'pre-show-serum:easy-melt-cleanser-balm,eyeup-all-in-1:bouncy-cream,ultrabalance5-serum:softcloud-cleanser,hydraplump-ocean-serum-milaborit:night-reset-malbec-cream,boost-collagen-malbec-serum:night-reset-malbec-cream,crema-corporal-rosa-mosqueta-vegaplay:vegaplay-®-patagonia-rescue-balm-balsamo-multiuso-con-calendula' | split: ','
  assign combo = false
  for pair in combo_pairs
    assign pp = pair | split: ':'
    if pp[0] == product.handle
      assign combo_p = all_products[pp[1]]
      assign combo_img = 'combo-' | append: pp[0] | append: '.png'
    endif
  endfor
  # combo_sep: espacio duro entre el "1" y el complemento, para que el 1 no quede colgado
  assign combo_sep = '&nbsp;'
  case product.handle
    when 'pre-show-serum'
      assign combo_sep = ' '
      assign combo_name = 'Pre-Show + limpieza'
      assign combo_main_t = product.title | remove: ' Milaborit' | remove: ' Serum'
      assign combo_add_t = combo_p.title | remove: ' Milaborit'
      assign combo_why = 'Con la piel bien limpia, el serum rinde mejor. El bálsamo saca maquillaje y protector sin resecar.'
      assign combo_noun = 'el bálsamo'
      assign combo_img_h = 421
    when 'eyeup-all-in-1'
      assign combo_name = 'EyeUp + hidratación'
      assign combo_main_t = 'EyeUp'
      assign combo_add_t = 'Bouncy Cream'
      assign combo_why = 'La crema sella la hidratación y fortalece la barrera.'
      assign combo_noun = 'la crema'
      assign combo_img_h = 421
    when 'ultrabalance5-serum'
      assign combo_name = 'UltraBalance + limpieza'
      assign combo_main_t = 'UltraBalance5+ Serum'
      assign combo_add_t = 'SoftCloud Cleanser'
      assign combo_why = 'Con la piel bien limpia, el serum se absorbe mejor. La espuma limpia en profundidad sin resecar.'
      assign combo_noun = 'la espuma'
      assign combo_img_h = 421
    when 'hydraplump-ocean-serum-milaborit'
      # 28-sep — upsell de la crema: es el Paso 2 del Kit Cuello y Mentón
      assign combo_name = 'Rutina cuello día + noche'
      assign combo_main_t = 'HydraPlump+'
      assign combo_add_t = 'NightReset+ Cream'
      assign combo_why = 'La crema sella el serum de noche en cuello y mentón.'
      assign combo_noun = 'la crema'
      assign combo_img_h = 421
    when 'boost-collagen-malbec-serum'
      # 29-sep — tratamiento completo del Kit Reafirmante: serum de día + NightReset de noche
      assign combo_name = 'Kit Reafirmante día + noche'
      assign combo_main_t = 'Boost Collagen'
      assign combo_add_t = 'NightReset+ Cream'
      assign combo_why = 'La crema de noche completa el tratamiento reafirmante.'
      assign combo_noun = 'la crema'
      assign combo_img_h = 421
    when 'crema-corporal-rosa-mosqueta-vegaplay'
      # 17-oct — Crema Corporal VegaPlay (C10): ritual completo = 2 cremas + Patagonia Rescue Balm
      assign combo_name = 'Ritual completo'
      assign combo_main_t = 'Cremas Corporales'
      assign combo_add_t = 'Patagonia Rescue Balm'
      assign combo_why = 'El bálsamo repara las zonas más secas: codos, rodillas, talones y manos.'
      assign combo_noun = 'el bálsamo'
      assign combo_img_h = 421
  endcase
  if combo_p != blank and combo_p.available
    assign cv_main = product.selected_or_first_available_variant
    assign cv_add = combo_p.selected_or_first_available_variant
    assign ok_main = false
    assign ok_add = false
    if cv_main.available
      if cv_main.inventory_management != 'shopify' or cv_main.inventory_policy == 'continue' or cv_main.inventory_quantity >= 2
        assign ok_main = true
      endif
    endif
    if cv_add.available
      if cv_add.inventory_management != 'shopify' or cv_add.inventory_policy == 'continue' or cv_add.inventory_quantity >= 1
        assign ok_add = true
      endif
    endif
    if ok_main and ok_add
      assign combo = true
      assign combo_pagan = cv_main.price | times: 2 | plus: cv_add.price
      assign combo_pay = combo_pagan | times: 0.925 | round
      assign ref_main = cv_main.compare_at_price
      if ref_main == blank or ref_main < cv_main.price
        assign ref_main = cv_main.price
      endif
      assign ref_add = cv_add.compare_at_price
      if ref_add == blank or ref_add < cv_add.price
        assign ref_add = cv_add.price
      endif
      assign combo_was = ref_main | times: 2 | plus: ref_add
      assign combo_save = combo_was | minus: combo_pay
      assign pay2 = product.price | times: 2 | times: 0.925 | round
      assign combo_extra = combo_pay | minus: pay2
    endif
  endif

  # 29-sep — UltraBalance5+ en 2x1: 2 unidades pagan $19.900 menos (descuento automatico
  # real "2x1 UltraBalance5+ (2 por $79.900)", BxGy, NO combina con el 15% de la 2da unidad).
  # Si cambia el monto del descuento en Shopify, cambiar dosx1_off aca.
  # 30-sep — sumado Pre-Show: "2x1 Pre-Show Serum (2 por $74.900)", $20.900 menos el par.
  assign dosx1 = false
  assign dosx1_off = 0
  if product.handle == 'ultrabalance5-serum'
    assign dosx1_off = 1990000
  # 5-oct — Pre-Show SALE del 2x1: pasa a la oferta de rutina (Pre-Show + balsamo), ver rut_pairs.
  # El descuento "2×1 — 2 por $59.900" se pausa cuando el Pre-Show baja a $35.000.
  elsif product.handle == 'crema-corporal-rosa-mosqueta-vegaplay'
    # 17-oct — Crema Corporal VegaPlay (C10): $36.900 (tachado $65.900) -> 2 por $65.900, $7.900 menos el par
    # (descuento real "2×1 — 2 por $65.900 — Crema Corporal VegaPlay", BxGy). Mismo número en vp-cc-landing (vpcc_off).
    assign dosx1_off = 790000
  elsif rbalm
    # 17-oct — Rescue Balm: descuento real "2do Rescue Balm al 44% OFF" (BxGy, porcentaje).
    assign dosx1_off = product.price | times: 0.44 | round
  elsif product.handle == 'kit-dia-de-la-madre'
    # 3-oct — Kit Día de la Madre: $69.900 (tachado $109.900) -> 2 por $109.900, $29.900 menos el par
    # (descuento real "2×1 — 2 por $109.900 — Kit Día de la Madre", BxGy). 3 kits = 25% OFF (kit25).
    assign dosx1_off = 2990000
  endif
  # 3-oct — textos propios del Kit Día de la Madre (1 mamá / 2 mamá + vos / 3 + papá)
  assign mama = false
  if product.handle == 'kit-dia-de-la-madre'
    assign mama = true
    if nota_txt == blank
      assign nota_txt = 'Cada kit trae 3-EN-1 Serum + Bouncy Cream. Con el 2×1, uno es para ella y otro para vos.'
    endif
  endif
  # 4-oct — OFERTA CON KIT (pedido de Facu): en el individual, la opcion del medio deja de
  # ser "2 unidades" y pasa a ser el KIT que lo contiene (serum + crema), al precio del kit.
  # Se agrega el producto KIT, no las dos piezas sueltas: sueltas entra el 7,5% de "2da
  # unidad" y el precio no coincide con el del kit. La 3ra opcion es kit + 1 unidad mas de
  # este producto (2 serums + crema); ahi si corre el 7,5% porque son 2 unidades en el carrito.
  # Pares individual:kit en kit_pairs; textos por handle en el case. Imagenes:
  # assets/kit-<handle>.png (opcion 2) y assets/combo-<handle>.png (opcion 3).
  # Si el kit o el individual no tienen stock, vuelve el selector de siempre.
  assign kit_pairs = 'boost-collagen-malbec-serum:kit-firmeza-hidratacion-profunda-botox-like-milaborit-1,hydraplump-ocean-serum-milaborit:kit-cuello-menton-lift-like-milaborit,eyeup-all-in-1:kit-tratamiento-ojeras-bolsas,pre-show-serum:kit-glass-skin-duo' | split: ','
  assign kitopt = false
  for pair in kit_pairs
    assign pp = pair | split: ':'
    if pp[0] == product.handle
      assign kit_p = all_products[pp[1]]
    endif
  endfor
  # 5-oct — Pre-Show usa el Kit Glass Skin Duo (kit_pairs); la rutina suelta queda de respaldo si el kit no tiene stock.
  # 5-oct — RUTINA SUELTA: igual que el kit pero sin producto kit (no existe): la opcion del medio
  # agrega las dos piezas (individual + complemento) y corre el 7,5% de "2da unidad", lo mismo
  # en la 3ra (2 individuales + complemento). Pares en rut_pairs (individual:complemento).
  assign rut_pairs = 'pre-show-serum:easy-melt-cleanser-balm' | split: ','
  for pair in rut_pairs
    assign pp = pair | split: ':'
    if pp[0] == product.handle
      assign rut_p = all_products[pp[1]]
    endif
  endfor
  assign mv = product.selected_or_first_available_variant
  assign ref_m = mv.compare_at_price
  if ref_m == blank or ref_m < mv.price
    assign ref_m = mv.price
  endif
  if kit_p != blank and kit_p.available
    assign kv = kit_p.selected_or_first_available_variant
    if kv.available and mv.available
      assign kitopt = true
      # "antes" del kit = su precio tachado (hoy $92.400 = las dos piezas a precio de lista)
      assign kit_was = kv.compare_at_price | default: 0
      if kit_was < kv.price
        assign kit_was = kv.price
      endif
      assign kit_pay = kv.price
      assign kit_bruto = kv.price
      assign kit_items = kv.id | append: ':1'
      assign k3_pagan = kv.price | plus: mv.price
      assign k3_items = kv.id | append: ':1,' | append: mv.id | append: ':1'
      assign kit_alt = kit_p.title
    endif
  elsif rut_p != blank and rut_p.available
    assign av = rut_p.selected_or_first_available_variant
    assign ok_m = false
    if mv.available
      if mv.inventory_management != 'shopify' or mv.inventory_policy == 'continue' or mv.inventory_quantity >= 2
        assign ok_m = true
      endif
    endif
    if ok_m and av.available
      assign kitopt = true
      assign ref_a = av.compare_at_price
      if ref_a == blank or ref_a < av.price
        assign ref_a = av.price
      endif
      assign kit_bruto = mv.price | plus: av.price
      assign kit_pay = kit_bruto | times: 0.925 | round
      assign kit_was = ref_m | plus: ref_a
      assign kit_items = mv.id | append: ':1,' | append: av.id | append: ':1'
      assign k3_pagan = mv.price | times: 2 | plus: av.price
      assign k3_items = mv.id | append: ':2,' | append: av.id | append: ':1'
      assign kit_alt = product.title | append: ' y ' | append: rut_p.title
    endif
  endif
  if kitopt
      case product.handle
        when 'boost-collagen-malbec-serum'
          assign kit_name = 'Rutina completa'
          assign kit_inc = '1 Boost Collagen + 1&nbsp;NightReset+ Cream'
          assign kit_why = 'Serum de día y crema de noche: el tratamiento reafirmante completo.'
          assign kit_badge = 'Más vendido'
          assign k3_name = 'Rutina + 1 serum extra'
          assign k3_inc = '2 Boost Collagen + 1&nbsp;NightReset+ Cream'
          assign k3_noun = 'otro serum'
        when 'hydraplump-ocean-serum-milaborit'
          assign kit_name = 'Rutina completa'
          assign kit_inc = '1 HydraPlump+ + 1&nbsp;NightReset+ Cream'
          assign kit_why = 'El serum y la crema que lo sella de noche: la rutina completa para cuello y mentón.'
          assign kit_badge = 'Más vendido'
          assign k3_name = 'Rutina + 1 serum extra'
          assign k3_inc = '2 HydraPlump+ + 1&nbsp;NightReset+ Cream'
          assign k3_noun = 'otro serum'
        when 'eyeup-all-in-1'
          assign kit_name = 'Rutina completa'
          assign kit_inc = '1 EyeUp + 1&nbsp;Bouncy Cream'
          assign kit_why = 'EyeUp para el contorno y la crema que sella la hidratación: la rutina completa para ojeras y bolsas.'
          assign kit_badge = 'Más vendido'
          assign k3_name = 'Rutina + 1 EyeUp extra'
          assign k3_inc = '2 EyeUp + 1&nbsp;Bouncy Cream'
          assign k3_noun = 'otro EyeUp'
        when 'pre-show-serum'
          assign kit_name = 'Rutina completa'
          assign kit_inc = 'Paso 1: bálsamo · Paso 2: Pre-Show'
          assign kit_why = 'El bálsamo limpia sin resecar y deja la piel lista para el serum. El Pre-Show le da glow y textura lisa, con o sin maquillaje.'
          assign kit_badge = 'Más vendido'
          assign k3_name = 'Rutina + 1 Pre-Show extra'
          assign k3_inc = '2 Pre-Show + 1&nbsp;bálsamo Easy Melt'
          assign k3_noun = 'otro Pre-Show'
      endcase
      assign kit_img = 'kit-' | append: product.handle | append: '.png'
      assign k3_img = 'combo-' | append: product.handle | append: '.png'
      assign kit_save = kit_was | minus: kit_pay
      assign k3_pay = k3_pagan | times: 0.925 | round
      assign k3_was = kit_was | plus: ref_m
      assign k3_save = k3_was | minus: k3_pay
      assign k3_extra = k3_pay | minus: kit_pay
      assign n = 1
  endif

  if pre_show_offer
    assign n = 2
    assign dosx1_off = product.price | times: 2 | minus: ref
    if kitopt and rut_p != blank and rut_p.available
      assign av = rut_p.selected_or_first_available_variant
      assign ref_a = av.compare_at_price | default: av.price
      if ref_a < av.price
        assign ref_a = av.price
      endif
      assign k3_pay = ref | plus: av.price
      assign k3_was = ref | times: 2 | plus: ref_a
      assign k3_save = k3_was | minus: k3_pay
      assign k3_pagan = mv.price | times: 2 | plus: av.price
      assign k3_items = mv.id | append: ':2,' | append: av.id | append: ':1'
    endif
  endif

  if dosx1_off > 0
    assign dosx1 = true
    assign pay2 = product.price | times: 2 | minus: dosx1_off
    if combo
      assign combo_pay = pay2 | plus: cv_add.price
      assign combo_save = combo_was | minus: combo_pay
      assign combo_extra = combo_pay | minus: pay2
    endif
  endif
-%}
<style>
#lbn-bundle{font-family:'Inter',sans-serif;color:#111;margin:18px 0 24px;}
#lbn-bundle *{box-sizing:border-box;}
.lbn-bundle__shipbar{display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap;background:#f4f0ed;border:0;height:44px;padding:0 14px;margin:0 0 20px;width:100%;text-align:center}
.lbn-bundle__shipbar svg{width:18px;height:18px;flex:0 0 18px;display:block;color:#232120}
.lbn-bundle__shipbar b{font-family:'Roboto Mono',monospace;text-transform:uppercase;letter-spacing:.14em;font-size:13px;font-weight:700;line-height:1;color:#232120}
.lbn-bundle__shipbar span{font-family:'Inter',sans-serif;font-size:11.5px;line-height:1.3;color:#8a857f}
@media(max-width:749px){.lbn-bundle__shipbar{height:auto;min-height:44px;padding:8px 12px;gap:6px}.lbn-bundle__shipbar b{font-size:12px}.lbn-bundle__shipbar span{font-size:11px}}
/* contradice el envio gratis: fuera en las fichas que usan este selector */
.product__info-container .product__tax{display:none}
.lbn-bundle__opt{position:relative;border:1px solid #e2ddd6;border-radius:0;padding:20px 18px;margin-top:20px;transition:background .15s ease,border-color .15s ease;cursor:pointer;}
.lbn-bundle__opt:first-of-type{margin-top:0}
.lbn-bundle__opt:hover{border-color:#bdb6ad}
.lbn-bundle__opt.is-active{background:#EBE359;border:1.5px solid #232120;padding:19.5px 17.5px;box-shadow:5px 5px 0 rgba(35,33,32,.13)}
.lbn-bundle__opt label{display:flex;align-items:center;justify-content:space-between;gap:13px;cursor:pointer;margin:0;width:100%;}
.lbn-bundle__opt input[type="radio"]{position:absolute;opacity:0;width:0;height:0;}
.lbn-bundle__dot{flex:0 0 17px;width:17px;height:17px;border:1px solid #cfc9c2;border-radius:50%;position:relative;background:#fff;align-self:center}
.lbn-bundle__opt.is-active .lbn-bundle__dot{border-color:#111}
.lbn-bundle__opt.is-active .lbn-bundle__dot::after{content:"";position:absolute;inset:3px;border-radius:50%;background:#111}
.lbn-bundle__main{display:flex;flex-direction:column;gap:7px;flex:1;justify-content:center}
.lbn-bundle__nameline{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.lbn-bundle__name{font-family:'Instrument Serif',serif;font-weight:400;font-size:20px;line-height:1;letter-spacing:-.01em;}
.lbn-bundle__pct{display:inline-block;font-family:'Roboto Mono',monospace;font-size:10.5px;font-weight:700;letter-spacing:.08em;background:#f1eee9;color:#232120;padding:4px 9px;border-radius:999px;white-space:nowrap;line-height:1}
.lbn-bundle__pct--plain{background:transparent;color:#8a857f;border:1px solid #d8d3cc;font-weight:500}
.lbn-bundle__meta{font-family:'Inter',sans-serif;font-size:12px;line-height:1.35;color:#5f5a55}
.lbn-bundle__meta b{font-weight:600;color:#111}
.lbn-bundle__free{color:#1d7a3e;font-weight:700;text-transform:uppercase;white-space:nowrap}
/* 25-sep — estructura tipo "descuentos": etiqueta por resultado arriba, ahorro al lado
   del nombre, dias de uso debajo y el precio anterior tachado en rojo. */
.lbn-bundle__save{display:inline-flex;align-items:center;font-family:'Roboto Mono',monospace;font-size:10.5px;font-weight:700;letter-spacing:.04em;background:#f1eee9;color:#232120;padding:5px 10px;border-radius:999px;line-height:1;white-space:nowrap}
.lbn-bundle__opt.is-active .lbn-bundle__save{background:#fff}
.lbn-bundle__was{color:#c0392b !important;opacity:1 !important}
