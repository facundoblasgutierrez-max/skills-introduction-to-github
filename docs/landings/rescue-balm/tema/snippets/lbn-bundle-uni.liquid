.lbn-tl__t{font-family:'Roboto Mono',monospace;text-transform:uppercase;letter-spacing:.14em;font-size:11px;color:#5f5a55;margin:0 0 12px}
.lbn-tl__row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;position:relative;margin:0;padding:0;list-style:none}
