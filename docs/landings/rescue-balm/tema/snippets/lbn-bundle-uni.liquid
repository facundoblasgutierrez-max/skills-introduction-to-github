</style>
<div class="lbn-bundle{% if lp01 %} lbn-bundle--lp01{% endif %} lbn-bundle--comfort" id="lbn-bundle">
  <p class="lbn-cq-pdp" data-lbn-cq="pdp" data-amount="{{ product.price }}">{%- render 'lbn-cuotas', amount: product.price, estilo: 'pdp' -%}</p>
  {%- if lp01 -%}<p class="lbn-bundle__h">Elegí tu kit. Aprovechá el ahorro.</p>{%- endif -%}
  <div class="lbn-bundle__shipbar">
    <span class="lbn-ship__line" aria-hidden="true"></span>
    <div class="lbn-ship__txt">
      {%- if lp01 -%}
      <b class="lbn-ship__offer">{% if free_from_one %}Envío gratis · {% endif %}{% render 'lbn-cuotas', estilo: 'hasta' %} · 10% OFF extra por transferencia</b>
      {%- else -%}
      <b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h10v9H3z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>Envío gratis</b>
      <span>{% if free_from_one %}en esta compra, sin mínimo{% else %}desde {{ fst | money_without_trailing_zeros }}{% if combo %} antes de descuentos{% endif %}{% endif %} · {% render 'lbn-cuotas', estilo: 'hasta' %}</span>
      {%- endif -%}
    </div>
    <span class="lbn-ship__line" aria-hidden="true"></span>
  </div>
  {%- for i in (1..n) -%}
    {%- liquid
      assign qty = i
      if qty == 1
        assign pay = product.price
        assign was = ref
      elsif dosx1 and qty == 2
        assign pay = pay2
        assign was = ref | times: qty
        if pre_show_offer
          assign was = product.price | times: qty
        endif
      elsif kit25 and qty >= 3
        assign pay = product.price | times: qty | times: 0.75 | round
        assign was = ref | times: qty
      else
        assign pay = product.price | times: qty | times: 0.925 | round
        assign was = ref | times: qty
      endif
      assign save = was | minus: pay
      assign unit = pay | divided_by: qty | divided_by: 100 | times: 100
      assign subtotal = product.price | times: qty
      assign dias_t = qty | times: dias_u
      # en la ficha con combo, 1 unidad no repite el ahorro: ya se ve tachado en el precio de arriba
      assign show_save = false
      if save > 0
        assign show_save = true
      endif
      if combo and qty == 1
        assign show_save = false
      endif
      if kitopt and qty == 1
        assign show_save = false
      endif
    -%}
    <div class="lbn-bundle__opt{% if qty == pre %} is-active{% endif %}{% if qty == best %} lbn-bundle__opt--best{% endif %}" data-qty="{{ qty }}" data-pay="{{ pay | money }}" data-cents="{{ pay }}">
      {%- liquid
        assign rotulo = 'Para empezar'
        if dosx1
          assign rotulo = 'Descuento de hoy'
        endif
        if qty == 2
          assign rotulo = 'Primeros resultados'
        elsif qty >= 3
          assign rotulo = 'Tratamiento completo'
        endif
        if lp01
          if qty == 1
            if lp_pct > 0
              assign rotulo = '1 kit · ' | append: lp_pct | append: '% OFF'
            else
              assign rotulo = '1 kit'
            endif
          elsif qty == 2
            assign rotulo = '2 kits · 15% extra en el segundo'
          else
            assign rotulo = '3 kits · 25% extra en los tres'
          endif
        endif
        if mama
          if qty == 1
            assign rotulo = 'Para regalar'
          elsif qty == 2
            assign rotulo = '2×1 · Para compartir la rutina'
          else
            assign rotulo = '25% OFF · Para toda la familia'
          endif
        endif
        if rbalm
          if qty == 1
            assign rotulo = 'Para probar'
          elsif qty == 2
            assign rotulo = '2×1 · Uno en casa, uno en la cartera'
          else
            assign rotulo = '25% OFF · Para regalar'
          endif
        endif
      -%}
      {%- if pre_show_offer and qty == best -%}
        <span class="lbn-bundle__badge">🔥 Oferta especial</span>
      {%- elsif mas_elegido and qty == best -%}
        <span class="lbn-bundle__badge">🔥 Más elegido</span>
      {%- else -%}
        {%- unless lp01 -%}<span class="lbn-bundle__badge{% if qty != best %} lbn-bundle__badge--soft{% endif %}">{% if qty == best %}🔥 {% endif %}{{ rotulo }}</span>{%- endunless -%}
      {%- endif -%}
      <input type="radio" name="lbn-bundle" id="lbn-buy{{ qty }}"{% if qty == pre %} checked{% endif %}>
      <label for="lbn-buy{{ qty }}"><span class="lbn-bundle__dot"></span><span class="lbn-bundle__main"><span class="lbn-bundle__nameline"><span class="lbn-bundle__name">{% if lp01 %}{{ rotulo }}{% elsif mama %}{% if qty == 1 %}1 kit · para mamá{% elsif qty == 2 %}2 kits · mamá + vos{% else %}3 kits · mamá, vos y papá{% endif %}{% elsif rbalm %}{{ qty }} bálsamo{% if qty > 1 %}s{% endif %}{% elsif pre_show_offer %}{% if qty == 2 %}<span class="lbn-preshow-2x1">2×1</span>{% else %}1 Pre-Show{% endif %}{% elsif dosx1 and qty == 2 %}2×1 Unidades{% elsif dosx1 %}1 Unidad{% elsif es_kit %}{{ qty }} kit{% if qty > 1 %}s{% endif %}{% else %}{{ qty }} unidad{% if qty > 1 %}es{% endif %}{% endif %}</span>{%- if show_save -%}<span class="lbn-bundle__save">Ahorrás {{ save | money_without_trailing_zeros }}</span>{%- endif -%}{%- capture cqs -%}{%- render 'lbn-cuotas', amount: pay, estilo: 'sello' -%}{%- endcapture -%}{%- if cqs != blank -%}<span class="lbn-bundle__cqs">{{ cqs }}</span>{%- endif -%}</span><span class="lbn-bundle__meta">{% if pre_show_offer and qty == 2 %}<span class="lbn-bundle__inc">2 Pre-Show Serum</span>{% endif %}{% if mama %}{% if qty == 1 %}3-EN-1 Serum + Bouncy Cream{% endif %}{% elsif lp01 %}{% else %}{{ dias_t }} días de uso{% endif %}{%- if qty > 1 %}{% unless mama or lp01 %} · {% endunless %}{{ unit | money_without_trailing_zeros }} por {% if es_kit %}kit{% else %}unidad{% endif %}{% endif -%}{%- if subtotal >= fst %}{% unless lp01 %} · <span class="lbn-bundle__free">envío gratis</span>{% endunless %}{% endif -%}<span class="lbn-bundle__cq">{%- render 'lbn-cuotas', amount: pay, estilo: 'opcion' -%}</span></span></span><span class="lbn-bundle__price"><span>{{ pay | money }}</span>{%- if was > pay -%}<span class="lbn-bundle__was">{{ was | money_without_trailing_zeros }}</span>{%- endif -%}</span></label>
    </div>
  {%- endfor -%}
  {%- if kitopt -%}
    {%- comment -%} 4-oct — opcion 2: el KIT (1 linea, el producto kit). data-items = lo que viaja a /cart/add. {%- endcomment -%}
    {%- unless pre_show_offer -%}
    <div class="lbn-bundle__opt lbn-bundle__opt--combo lbn-bundle__opt--best" data-qty="1" data-combo="kit" data-items="{{ kit_items }}" data-pay="{{ kit_pay | money }}" data-cents="{{ kit_pay }}">
      {%- assign cyber_kit_handles = 'kit-firmeza-hidratacion-profunda-botox-like-milaborit-1,kit-cuello-menton-lift-like-milaborit,kit-tratamiento-ojeras-bolsas' | split: ',' -%}
      <span class="lbn-bundle__badge">{%- if cyber_kit_handles contains kit_p.handle and kit_p.compare_at_price > kit_p.price -%}🔥 CYBER BEAUTY{%- else -%}🔥 {% if mas_elegido %}Más elegido{% else %}{{ kit_badge }}{% endif %}{%- endif -%}</span>
      <input type="radio" name="lbn-bundle" id="lbn-buykit">
      <label for="lbn-buykit"><span class="lbn-bundle__dot"></span><img class="lbn-bundle__thumb" src="{{ kit_img | asset_url }}" width="480" height="421" loading="lazy" alt="{{ kit_alt | escape }}"><span class="lbn-bundle__main"><span class="lbn-bundle__nameline"><span class="lbn-bundle__name">{{ kit_name }}</span>{%- if kit_save > 0 -%}<span class="lbn-bundle__save">Ahorrás {{ kit_save | divided_by: 100 | times: 100 | money_without_trailing_zeros }}</span>{%- endif -%}{%- capture cqs -%}{%- render 'lbn-cuotas', amount: kit_pay, estilo: 'sello' -%}{%- endcapture -%}{%- if cqs != blank -%}<span class="lbn-bundle__cqs">{{ cqs }}</span>{%- endif -%}</span><span class="lbn-bundle__meta"><span class="lbn-bundle__inc"><b>{{ kit_inc }}</b></span><span class="lbn-bundle__inc lbn-bundle__why">{{ kit_why }}</span>{%- if kit_bruto >= fst -%}<span class="lbn-bundle__inc"><span class="lbn-bundle__free">envío gratis</span></span>{%- endif -%}<span class="lbn-bundle__cq">{%- render 'lbn-cuotas', amount: kit_pay, estilo: 'opcion' -%}</span></span></span><span class="lbn-bundle__price"><span>{{ kit_pay | money }}</span>{%- if kit_was > kit_pay -%}<span class="lbn-bundle__was">{{ kit_was | money_without_trailing_zeros }}</span>{%- endif -%}</span></label>
    </div>
    {%- endunless -%}
    {%- comment -%} opcion 3: kit + 1 unidad mas de este producto (2 lineas). {%- endcomment -%}
    <div class="lbn-bundle__opt lbn-bundle__opt--combo" data-qty="2" data-combo="kit" data-items="{{ k3_items }}" data-pay="{{ k3_pay | money }}" data-cents="{{ k3_pay }}">
      <span class="lbn-bundle__badge lbn-bundle__badge--soft">Tratamiento completo</span>
      <input type="radio" name="lbn-bundle" id="lbn-buykit3">
      <label for="lbn-buykit3"><span class="lbn-bundle__dot"></span><img class="lbn-bundle__thumb" src="{{ k3_img | asset_url }}" width="480" height="421" loading="lazy" alt="{{ kit_alt | escape }} y 1 {{ product.title | escape }}"><span class="lbn-bundle__main"><span class="lbn-bundle__nameline"><span class="lbn-bundle__name">{% if pre_show_offer %}Rutina completa{% else %}{{ k3_name }}{% endif %}</span><span class="lbn-bundle__save">Ahorrás {{ k3_save | divided_by: 100 | times: 100 | money_without_trailing_zeros }}</span>{%- capture cqs -%}{%- render 'lbn-cuotas', amount: k3_pay, estilo: 'sello' -%}{%- endcapture -%}{%- if cqs != blank -%}<span class="lbn-bundle__cqs">{{ cqs }}</span>{%- endif -%}</span><span class="lbn-bundle__meta"><span class="lbn-bundle__inc"><b>{{ k3_inc }}</b></span><span class="lbn-bundle__inc">{% if pre_show_offer %}Sumá el bálsamo por <b>{{ k3_pay | minus: pay2 | money_without_trailing_zeros }}</b> más que el pack de 2{% else %}Sumá {{ k3_noun }} por <b>{{ k3_extra | divided_by: 100 | times: 100 | money_without_trailing_zeros }}</b> más que la rutina{% endif %}{%- if k3_pagan >= fst %} · <span class="lbn-bundle__free">envío gratis</span>{% endif -%}</span><span class="lbn-bundle__cq">{%- render 'lbn-cuotas', amount: k3_pay, estilo: 'opcion' -%}</span></span></span><span class="lbn-bundle__price"><span>{{ k3_pay | money }}</span>{%- if k3_was > k3_pay -%}<span class="lbn-bundle__was">{{ k3_was | money_without_trailing_zeros }}</span>{%- endif -%}</span></label>
    </div>
  {%- elsif combo -%}
    <div class="lbn-bundle__opt lbn-bundle__opt--combo" data-qty="2" data-combo="1" data-pay="{{ combo_pay | money }}" data-cents="{{ combo_pay }}" data-main="{{ cv_main.id }}" data-add="{{ cv_add.id }}">
      <span class="lbn-bundle__badge lbn-bundle__badge--soft">Rutina completa</span>
      <input type="radio" name="lbn-bundle" id="lbn-buycombo">
      <label for="lbn-buycombo"><span class="lbn-bundle__dot"></span><img class="lbn-bundle__thumb" src="{{ combo_img | asset_url }}" width="480" height="{{ combo_img_h }}" loading="lazy" alt="2 {{ product.title | escape }} y 1 {{ combo_p.title | escape }}"><span class="lbn-bundle__main"><span class="lbn-bundle__nameline"><span class="lbn-bundle__name">{{ combo_name }}</span><span class="lbn-bundle__save">Ahorrás {{ combo_save | divided_by: 100 | times: 100 | money_without_trailing_zeros }}</span>{%- capture cqs -%}{%- render 'lbn-cuotas', amount: combo_pay, estilo: 'sello' -%}{%- endcapture -%}{%- if cqs != blank -%}<span class="lbn-bundle__cqs">{{ cqs }}</span>{%- endif -%}</span><span class="lbn-bundle__meta"><span class="lbn-bundle__inc"><b><span class="lbn-bundle__nw">2 {{ combo_main_t }}</span> + 1{{ combo_sep }}{{ combo_add_t }}</b></span><span class="lbn-bundle__inc lbn-bundle__why">{{ combo_why }}</span><span class="lbn-bundle__inc">Sumá {{ combo_noun }} por <b>{{ combo_extra | money_without_trailing_zeros }}</b> más que el pack de 2{%- if combo_was >= fst %} · <span class="lbn-bundle__free">envío gratis</span>{% endif -%}</span><span class="lbn-bundle__cq">{%- render 'lbn-cuotas', amount: combo_pay, estilo: 'opcion' -%}</span></span></span><span class="lbn-bundle__price"><span>{{ combo_pay | money }}</span>{%- if combo_was > combo_pay -%}<span class="lbn-bundle__was">{{ combo_was | money_without_trailing_zeros }}</span>{%- endif -%}</span></label>
    </div>
  {%- endif -%}
  {%- if product.handle == 'pre-show-serum' -%}
  <div class="lbn-tl">
    <p class="lbn-tl__t">Qué notás y cuándo</p>
    <ol class="lbn-tl__row">
      <li><span class="lbn-tl__d">Día 1</span><span class="lbn-tl__x">Glow desde la primera aplicación.</span></li>
      <li><span class="lbn-tl__d">Semana 3–4</span><span class="lbn-tl__x">La textura se ve más lisa y pareja.</span></li>
      <li class="is-meta"><span class="lbn-tl__d">Día 60</span><span class="lbn-tl__x">Piel luminosa que se sostiene.</span></li>
    </ol>
    <p class="lbn-tl__n">1 unidad rinde unos 30 días. A los 60 días de uso sostenido la exfoliación suave muestra su mejor resultado.</p>
  </div>
  {%- endif -%}
  {%- if product.handle == 'crema-corporal-rosa-mosqueta-vegaplay' -%}
  <div class="lbn-tl">
    <p class="lbn-tl__t">Qué notás y cuándo</p>
    <ol class="lbn-tl__row">
      <li><span class="lbn-tl__d">Día 1</span><span class="lbn-tl__x">Piel suave y sin tirantez.</span></li>
      <li><span class="lbn-tl__d">Semana 2</span><span class="lbn-tl__x">Más elástica y luminosa.</span></li>
      <li class="is-meta"><span class="lbn-tl__d">Semana 4–8</span><span class="lbn-tl__x">Las estrías se ven menos.</span></li>
    </ol>
    <p class="lbn-tl__n">La constancia es la clave: con 2 cremas sostenés el ritual diario sin cortar.</p>
  </div>
  {%- endif -%}
  {%- if product.handle == 'ultrabalance5-serum' -%}
  <div class="lbn-tl">
    <p class="lbn-tl__t">Qué notás y cuándo</p>
    <ol class="lbn-tl__row">
      <li><span class="lbn-tl__d">Semana 1</span><span class="lbn-tl__x">Menos brillo durante el día.</span></li>
      <li><span class="lbn-tl__d">Semana 3–4</span><span class="lbn-tl__x">Poros más afinados y menos rojeces.</span></li>
      <li class="is-meta"><span class="lbn-tl__d">Día 60</span><span class="lbn-tl__x">Piel más equilibrada, con menos imperfecciones nuevas.</span></li>
    </ol>
    <p class="lbn-tl__n">1 unidad rinde unos 30 días. La piel se renueva más o menos una vez por mes: con el 2×1 cubrís dos ciclos completos, que es cuando se ve el cambio.</p>
  </div>
  {%- endif -%}
  {%- if nota_txt != blank -%}<p class="lbn-bundle__nota">{{ nota_txt }}</p>{%- endif -%}
</div>
<script>
/* Posicion unificada: el selector siempre va ARRIBA de Cantidad + Agregar al carrito,
   como en el Kit Reafirmante. Si el template lo tiene abajo del boton, se mueve aca
   mismo (antes de pintar), sin tocar el JSON del template. */
(function(){
  var root=document.getElementById('lbn-bundle');if(!root)return;
  /* 7-oct — la línea de cuotas va pegada debajo del precio de la ficha */
  var cqp=root.querySelector('.lbn-cq-pdp'),info=root.closest('.product__info-container')||document,pr=info.querySelector('[id^="price-"]');
  if(cqp&&pr&&pr.parentElement){pr.insertAdjacentElement('afterend',cqp);}
  var box=root.parentElement;if(!box)return;
  var anchor=box.querySelector(':scope > .product-form__quantity');
  if(!anchor){var pf=box.querySelector('product-form');if(pf){anchor=pf;while(anchor.parentElement&&anchor.parentElement!==box){anchor=anchor.parentElement;}}}
  if(anchor&&anchor.parentElement===box&&(root.compareDocumentPosition(anchor)&Node.DOCUMENT_POSITION_PRECEDING)){box.insertBefore(root,anchor);}
})();
document.addEventListener("DOMContentLoaded",function(){
  var root=document.getElementById('lbn-bundle');
  if(!root)return;
  var PRE={{ pre }};

  /* 18-sep — el bloque "Cantidad" del tema se saco de la ficha: la cantidad la fija
     el selector. Si no hay input[name=quantity] en el form, se crea uno oculto;
     sin esto entraria siempre 1 unidad al carrito. */
  /* OJO: la ficha tiene DOS forms con action /cart/add en la columna de compra, y
     Dawn manda el que esta adentro de <product-form>. Si el input oculto va a uno
     solo, entra 1 unidad. Por eso se le pone a todos. */
  function forms(){
    var l=[].slice.call(document.querySelectorAll('.product__info-container form[action*="/cart/add"]'));
    if(!l.length)l=[].slice.call(document.querySelectorAll('form[action*="/cart/add"]'));
    return l;
  }
  function qtyInputs(){
    return forms().map(function(form){
      var i=form.querySelector('input[name="quantity"]');
      if(!i){i=document.createElement('input');i.type='hidden';i.name='quantity';i.value='1';form.appendChild(i);}
      return i;
    });
  }

  function boton(){return document.querySelector('.product__info-container .product-form__submit');}

  function setActive(opt){root.querySelectorAll('.lbn-bundle__opt').forEach(function(o){o.classList.remove('is-active');});opt.classList.add('is-active');}
  function setQty(v){qtyInputs().forEach(function(i){i.value=v;});}
  function setLabel(precio){
    var b=boton();
    if(!b||b.disabled||!precio)return;   /* agotado: no le pisamos el "Agotado" del tema */
    var s=b.querySelector('span')||b;
    var txt={{ cta_txt | json }}+' · '+precio;
    if(s.textContent.trim()!==txt)s.textContent=txt;
  }
  function aplicar(opt){
    setActive(opt);
    setQty(parseInt(opt.dataset.qty,10));
    setLabel(opt.dataset.pay);
    /* 7-oct — cuotas de la opción elegida, debajo del precio */
    var cqp=document.querySelector('.lbn-cq-pdp');
    if(cqp&&opt.dataset.cents){cqp.setAttribute('data-amount',Math.round(opt.dataset.cents));if(window.LBNCuotas)LBNCuotas.pintar(cqp);}
  }

  root.querySelectorAll('input[type="radio"]').forEach(function(r){
    r.addEventListener('change',function(){aplicar(this.closest('.lbn-bundle__opt'));});
  });

  /* 21-sep — COMBO: el form del tema manda UNA variante. Con el combo activo se
     reemplaza lo que viaja a /cart/add por dos lineas (items[]) en el evento
     "formdata", que dispara cuando product-form.js arma el FormData. Asi el alta
     sigue el camino normal del tema: bloqueo de doble click (aria-disabled),
     secciones del carrito, cajon que se abre y mensajes de error. */
  forms().forEach(function(form){
    form.addEventListener('formdata',function(e){
      var act=root.querySelector('.lbn-bundle__opt.is-active');
      if(!act)return;
      var fd=e.formData;
      /* 4-oct — oferta con kit: data-items="variante:cant,variante:cant" */
      if(act.dataset.items){
        fd.delete('id');fd.delete('quantity');
        act.dataset.items.split(',').forEach(function(p,k){
          var x=p.split(':');
          fd.append('items['+k+'][id]',x[0]);fd.append('items['+k+'][quantity]',x[1]);
        });
        return;
      }
      if(act.dataset.combo!=='1')return;
      fd.delete('id');fd.delete('quantity');
      fd.append('items[0][id]',act.dataset.main);fd.append('items[0][quantity]','2');
      fd.append('items[1][id]',act.dataset.add);fd.append('items[1][quantity]','1');
    });
  });

  var inicial=root.querySelector('.lbn-bundle__opt[data-qty="'+PRE+'"]:not([data-combo])')||root.querySelector('.lbn-bundle__opt');
  if(inicial)aplicar(inicial);

  /* el tema repinta el boton al cambiar de variante: volvemos a poner el precio */
  var b=boton();
  if(b&&window.MutationObserver){
    var mo=new MutationObserver(function(){
      var act=root.querySelector('.lbn-bundle__opt.is-active');
      if(act)setLabel(act.dataset.pay);
    });
    mo.observe(b,{childList:true,subtree:true,characterData:true});
  }
});
</script>
