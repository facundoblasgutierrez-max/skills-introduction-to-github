      <div class="vprb-cmp__t" role="table">
        <div class="vprb-cmp__row vprb-cmp__row--hd" role="row"><span role="columnheader"></span><span class="vprb-cmp__us" role="columnheader">Rescue Balm</span><span class="vprb-cmp__th" role="columnheader">Los de siempre</span></div>
        {%- capture rows -%}Agua|Cero|Las cremas, 60 a 80%|Base|Ceras y mantecas vegetales|Cera de abeja, lanolina o siliconas|Vegano|sí|Muchos llevan cera de abejas o colágeno|Origen|Caléndula de la Patagonia, rastreada|«Natural», sin decir de dónde|Hecho en|Argentina, laboratorio propio|Importado o de etiqueta|Pasos|Uno solo, de noche|Sérum + crema + contorno|Promesas|Las que cumple la fórmula|Milagros garantizados|Parabenos|Cero|Frecuentes|Rinde|Meses: una lenteja por noche|Se termina rápido{%- endcapture -%}
        {%- assign r = rows | split: '|' -%}
        {%- for i in (0..8) -%}
          {%- assign k = i | times: 3 -%}{%- assign a = k | plus: 1 -%}{%- assign b = k | plus: 2 -%}
